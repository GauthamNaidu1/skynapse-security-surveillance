# GEMINI_API_KEY: Required for Gemini AI video analysis and tactical advice.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# ML_SERVICE_URL: Optional external URL for python/serve.py microservice (e.g., Render / Hugging Face Spaces)
# If left empty in local development, defaults to http://127.0.0.1:8000
# On Vercel, if left empty, the server automatically uses the built-in heuristic fallback without throwing errors.
ML_SERVICE_URL=""

# APP_URL: Optional self-referential URL where this app is hosted.
APP_URL="http://localhost:3000"

# PORT: Optional local server port (defaults to 3000)
PORT=3000
